# Copy to .env and adjust values. Never commit the real .env file.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/erp

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to True ONLY for initial dev setup.
# In production: False — use Alembic migrations instead.
AUTO_CREATE_TABLES=False

DEBUG=False

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
FIRST_ADMIN_FULL_NAME=مدير النظام

# Comma-separated allowed origins (no trailing slashes)
CORS_ORIGINS=https://erp.yourdomain.com
